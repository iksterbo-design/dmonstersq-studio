# Copy this file to  android/keystore.properties  and fill it in.
# NEVER commit keystore.properties or the .jks file itself.
#
# Generate a keystore first:
#   keytool -genkeypair -v -keystore dmq-release.jks \
#     -alias dmq -keyalg RSA -keysize 2048 -validity 10000

storeFile=../dmq-release.jks
storePassword=CHANGE_ME
keyAlias=dmq
keyPassword=CHANGE_ME
